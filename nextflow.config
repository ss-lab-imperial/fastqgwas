manifest {
    name            = 'ss-lab-imperial/fastqgwas'
    description     = 'A small GWAS from raw reads: align, call SNPs, test association'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    version         = '1.2.0'
    nextflowVersion = '!>=24.04.0'
}

params {
    input      = null
    fasta      = null
    phenotypes = null
    outdir     = null
    max_reads  = 300000   // reads aligned per sample: about 10x depth, plenty to call genotypes
    min_qual   = 20
    help       = false

    // Institutional profiles (-profile imperial), as in nf-core pipelines
    custom_config_version = 'master'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

// Defaults when no institutional profile is given (e.g. on your own computer)
process {
    cpus   = 1
    memory = '2 GB'
    time   = '1 h'

    // Containers: the images nf-core's own modules use (Singularity form on HPC, Docker otherwise).
    // Ignored unless a container engine is on (-profile imperial turns on Singularity).
    withName: 'PREP_REF|ALIGN' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/70/7093a62c894ad3337cabda5efadce78a3ecdb5ba34cf8646743c6d43d8c4b77d/data'
            : 'community.wave.seqera.io/library/bowtie2_htslib_samtools_pigz:e1c7af09e1513a6c' }
    }
    withName: 'CALL' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/91/914b9b38bbfa22c458ceee6c578fd3d70ee1bffc33d3a064b0663ed4944e7872/data'
            : 'community.wave.seqera.io/library/bcftools_htslib:1.25--130aa7603bf3bf5c' }
    }
    withName: 'ASSOC' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://depot.galaxyproject.org/singularity/plink2:2.00a5.12--h4ac6f70_0'
            : 'quay.io/biocontainers/plink2:2.00a5.12--h4ac6f70_0' }   // nf-core's plink2 (2.00a2.3) is too old for allow-no-covars
    }
}

profiles {
    test {
        params.input      = "${projectDir}/test_data/samplesheet.csv"
        params.fasta      = "${projectDir}/test_data/ref.fa"
        params.phenotypes = "${projectDir}/test_data/phenotypes.tsv"
        // no outdir: as in nf-core, always give --outdir
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    docker {
        docker.enabled = true
    }
    // Fallback on Imperial's HPC if the containers can't be pulled: -profile imperial,modules
    // loads the cluster's own modules instead (same toolchain generation, so they load together)
    modules {
        singularity.enabled = false
        process.module = 'Bowtie2/2.5.1-GCC-12.3.0:SAMtools/1.18-GCC-12.3.0:BCFtools/1.18-GCC-12.3.0:PLINK/2.00a3.7-gfbf-2023a'
    }
}

// nf-core's institutional configs, which define -profile imperial (and others)
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Execution reports, written to <outdir>/pipeline_info/ as nf-core pipelines do: a text trace
// (one row per task), an HTML report and timeline, and a diagram of the steps. The timestamp
// keeps each run's files, so runs (and releases) can be compared.
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}
